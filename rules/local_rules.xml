<!--
  Собственные правила SOC-лаборатории (Wazuh 4.x).
  Диапазон ID: 100100-100199. Каждое правило размечено техникой MITRE ATT&CK.
  Путь на менеджере: /var/ossec/etc/rules/local_rules.xml
  Проверка: /var/ossec/bin/wazuh-logtest
-->
<group name="soclab,">

  <!-- 1. Linux: SSH-брутфорс — 8+ неудачных входов с одного IP за 2 минуты -->
  <rule id="100100" level="10" frequency="8" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>SSH brute force: 8+ failed logins from $(srcip) in 120s</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_10.2.4,</group>
  </rule>

  <!-- 2. Windows: PowerShell с закодированной командой (-enc / -EncodedCommand) -->
  <rule id="100101" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/](powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-(e|en|enc|encodedcommand)\s+[A-Za-z0-9+/=]{20,}</field>
    <description>Encoded PowerShell command executed on $(win.system.computer)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>execution,</group>
  </rule>

  <!-- 3. Windows: признаки Mimikatz в командной строке -->
  <rule id="100102" level="14">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sekurlsa::|lsadump::|privilege::debug|kerberos::golden|mimikatz)</field>
    <description>Mimikatz-like command line on $(win.system.computer)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!-- 4. Windows: подозрительный доступ к памяти LSASS (Sysmon Event 10) -->
  <rule id="100103" level="13">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)[\\/]lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|143a|1fffff)$</field>
    <description>LSASS memory access by $(win.eventdata.sourceImage)</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,</group>
  </rule>

  <!-- 5. Windows: закрепление через ключ автозапуска Run/RunOnce (Sysmon Event 13) -->
  <rule id="100104" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)CurrentVersion\\+Run(Once)?\\+</field>
    <description>Registry Run key modified: $(win.eventdata.targetObject)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,</group>
  </rule>

  <!-- 6. Windows: создание запланированной задачи через schtasks /create -->
  <rule id="100105" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)[\\/]schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s/create\s</field>
    <description>Scheduled task created on $(win.system.computer)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,execution,</group>
  </rule>

  <!-- 7. Linux: скан портов, найденный Python-детектором (soclab portscan -> JSON) -->
  <rule id="100106" level="10">
    <decoded_as>json</decoded_as>
    <field name="detector" type="pcre2">^portscan$</field>
    <description>Port scan ($(scan_type)) from $(src_ip): $(ports_count) ports / $(hosts_count) hosts</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,</group>
  </rule>

</group>
